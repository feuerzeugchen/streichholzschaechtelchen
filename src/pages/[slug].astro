---
import StimmeLayout from '../layouts/StimmeLayout.astro';
import fs from 'fs';
import path from 'node:path';
import { marked } from 'marked';
import { Image } from 'astro:assets';
import.meta.glob('./src/assets/**/*.mp3');

export async function getStaticPaths() {
  // Lese alle Markdown-Dateien im Verzeichnis
  const postsDirectory = path.resolve('./src/content/postsstimme');
  const markdownFiles = fs.readdirSync(postsDirectory)
    .filter(file => file.endsWith('.md'));
  
  // Erstelle einen Pfad für jede Datei
  return markdownFiles.map(file => {
    return {
      params: { 
        slug: file.replace('.md', '') 
      },
      props: { 
        filename: file 
      }
    };
  });
}

const { slug } = Astro.params;
const { filename } = Astro.props;

// Lade die entsprechende Markdown-Datei
const markdownPath = path.resolve(`./src/content/postsstimme/${filename}`);
const rawMarkdown = fs.readFileSync(markdownPath, 'utf-8');

// Funktion zum Entfernen von Text zwischen %% und %%
function removeHiddenContent(markdown) {
  return markdown.replace(/%%.*?%%/gs, ''); // Entfernt alles zwischen %% und %%
}


// Teile den Markdown-Inhalt in Abschnitte nach H2-Überschriften
const h2Regex = /^##\s+(.*)$/gm;
let sections = [];
let matches = Array.from(rawMarkdown.matchAll(h2Regex));

for (let i = 0; i < matches.length; i++) {
  const title = matches[i][1].trim();
  const startIndex = matches[i].index + matches[i][0].length;
  const endIndex = i + 1 < matches.length ? matches[i + 1].index : rawMarkdown.length;

  const content = rawMarkdown.slice(startIndex, endIndex).trim();
  const html = marked(content);

  sections.push({
    title,
    content,
    html,
  });
}

// Falls keine H2-Überschriften vorhanden sind, behandle die gesamte Datei als einen Abschnitt
if (sections.length === 0) {
  sections.push({
    title: slug.replace(/-/g, ' '),
    content: rawMarkdown,
    html: marked(rawMarkdown),
  });
}

// Funktion zur Aufteilung von langen Inhalten
function splitContentIntoRectangles(sections) {
  const rectangles = [];
  const approximateCharsPerRectangle = 1200; // Anpassen je nach Bedarf
  
  sections.forEach(section => {
    // HTML-Tags entfernen, um die Textlänge besser abschätzen zu können
    const plainText = section.content.replace(/<[^>]*>/g, '');
    
    // Wenn der Inhalt kurz genug ist, füge ihn direkt hinzu
    if (plainText.length <= approximateCharsPerRectangle) {
      rectangles.push({
        title: section.title,
        html: section.html,
        isFirstPart: true,
        isLastPart: true
      });
    } else {
      // Teile den Inhalt in Absätze auf
      const paragraphs = section.html.split(/<\/p>\s*<p>/);
      let currentRectangle = {
        title: section.title,
        html: '',
        paragraphs: [],
        isFirstPart: true,
        isLastPart: false
      };
      let currentLength = 0;
      
      paragraphs.forEach((paragraph, index) => {
        // Bereinige den Absatz
        let cleanParagraph = paragraph;
        if (index === 0) cleanParagraph = paragraph.replace(/^<p>/, '');
        if (index === paragraphs.length - 1) cleanParagraph = cleanParagraph.replace(/<\/p>$/, '');
        
        const paragraphLength = cleanParagraph.replace(/<[^>]*>/g, '').length;
        
        // Wenn dieser Absatz das Rectangle überfüllen würde, erstelle ein neues Rectangle
        if (currentLength > 0 && currentLength + paragraphLength > approximateCharsPerRectangle) {
          // Schließe das aktuelle Rectangle ab
          currentRectangle.html = '<p>' + currentRectangle.paragraphs.join('</p><p>') + '</p>';
          rectangles.push(currentRectangle);
          
          // Starte ein neues Rectangle
          currentRectangle = {
            title: `${section.title}`,
            html: '',
            paragraphs: [cleanParagraph],
            isFirstPart: false,
            isLastPart: false
          };
          currentLength = paragraphLength;
        } else {
          // Füge den Absatz zum aktuellen Rectangle hinzu
          currentRectangle.paragraphs.push(cleanParagraph);
          currentLength += paragraphLength;
        }
      });
      
      // Letztes Rectangle für diesen Abschnitt abschließen
      currentRectangle.html = '<p>' + currentRectangle.paragraphs.join('</p><p>') + '</p>';
      currentRectangle.isLastPart = true;
      rectangles.push(currentRectangle);
    }
  });
  
  return rectangles;
}

const contentRectangles = splitContentIntoRectangles(sections);
---

<StimmeLayout title={slug.replace(/-/g, ' ')}>
  <div class="theme-toggle-container">
    <button id="theme-toggle">Toggle Dark Mode</button>
    <a href="/" class="back-link">Zurück zur Übersicht</a>
  </div>
  
  <div class="rectangle-container">
    {contentRectangles.map((rectangle, index) => (
      <article class="content-rectangle" id={`rectangle-${index}`}>
        <h2 class="titlebox">
          {rectangle.title}
          {!rectangle.isFirstPart && <span class="continuation-marker"> (Fortsetzung)</span>}
        </h2>
        <audio id={`audio-${index}`}>
          <source src={`${import.meta.env.BASE_URL}wenker${index + 1}.mp3`} type="audio/mpeg" />
          Your browser does not support the audio element.
        </audio>
        <div class="rectangle-content">
          <div set:html={rectangle.html} />
          {!rectangle.isLastPart && 
            <div class="continuation-notice">Fortsetzung →</div>
          }
        </div>
      </article>
    ))}
  </div>
</StimmeLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const rectangles = document.querySelectorAll('.content-rectangle');
    rectangles.forEach((rectangle, index) => {
      const audio = rectangle.querySelector(`#audio-${index}`);
      rectangle.addEventListener('mouseenter', () => {
        audio.play();
      });
      rectangle.addEventListener('mouseleave', () => {
        setTimeout(() => {
          audio.pause();
          audio.currentTime = 0;
        },0);
      });
    });
    
    // Dark mode toggle logic
    const themeToggle = document.getElementById('theme-toggle');
    const htmlElement = document.documentElement;

    themeToggle.addEventListener('click', () => {
      const currentTheme = htmlElement.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      htmlElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
    });

    // Load saved theme from localStorage
    const savedTheme = localStorage.getItem('theme') || 'light';
    htmlElement.setAttribute('data-theme', savedTheme);
  });
</script>

<style>
  /* Übernimm alle Styles aus deinem Original-Code und füge diese hinzu: */
  .back-link {
    margin-left: 1rem;
    color: var(--text-color);
    text-decoration: none;
    font-size: 0.8rem;
  }
  
  .back-link:hover {
    text-decoration: underline;
  }
  
  .continuation-marker {
    font-size: 0.8em;
    font-weight: normal;
    opacity: 0.8;
  }
  
  .continuation-notice {
    text-align: right;
    font-style: italic;
    margin-top: 1rem;
    font-size: 0.8rem;
    opacity: 0.8;
  }
  
  /* Hier kommen alle deine originalen Styles */
  html {
    font-size: 110%;
    font-family: 'PT Sans';
    background-color: var(--background-color);
    color: var(--text-color);
  } 
  /* Weitere Styles aus deinem Original-Code */
  .theme-toggle-container {
    text-align: left;
    margin: 1rem 1rem;
  }

  #theme-toggle {
    padding: 0.2rem 0.3rem;
    font-size: 0.7rem;
    cursor: pointer;
  }
  :root {
    --background-color: rgb(228, 228, 228);
    --text-color: black;
    --content-bg-color: rgb(255, 255, 255);
  }

  [data-theme="dark"] {
    --background-color: rgb(34, 34, 34);
    --text-color: white;
    --content-bg-color: rgb(50, 50, 50);
  } 
  @media screen and (max-width: 700px) {
    html {
      font-size:3.1vw;
    }
  }
  
  body {
    margin: 0;
    padding: 0;
  }

  .titlebox {
    height: 5rem;
  }
  
  .rectangle-container {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center; /* Center rectangles horizontally */
  }
  
  .content-rectangle {
    background-color: var(--content-bg-color);
    height:  42.5rem;
    width: 25.1rem;
    aspect-ratio: 1 / 1.4174460775;
    overflow-y: hidden;
    padding: 1.5rem 3.5rem;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    font-size: 0.9rem; /* Ensure readable font size */
    margin: auto;
    display: flex;
    flex-direction: column;
  }
  
  .content-rectangle h2 {
    text-align: left;
    font-weight:bold;
    font-size: 1.1rem;
  }
  
  .content-rectangle :global( audio ) {
    width: 100%;
    background-color: #fd0c0c;
    border-radius: 4px;
  }
  
  .rectangle-content {
    flex: 1;
    display: flex;
    text-wrap:pretty ;
    justify-content: center;
    align-items: center;
    text-align:justify;
    word-break: normal;
    margin-top: -6em; /* Add some space between the audio and the content */
    flex-direction: column; /* Ensure the p elements are stacked vertically */
    hyphens: auto;
    -moz-hyphens: auto;
    -o-hyphens: auto;
    -webkit-hyphens: auto;
    -ms-hyphens: auto;
  }

  
  .rectangle-content p {
    margin: 0; /* Remove default margin */
  }
  :global(table, th, td) {
    border: 1px;
    text-align: left;
    vertical-align: top;
    padding-inline: 0.9rem;
    padding-left: 0;
    width:max-content;
    font-size: 100%;
  }
  
  .content-rectangle :global( img ) {
    width: 100%;
    max-width: 100%; /* Set a maximum width */
    max-height: 20rem; /* Set a maximum height */
    margin: auto;
    display: block;
    object-fit: contain; /* Ensure the content fits within the container */
  }
  
  .content-rectangle :global( video ) {
    width: 100%;
    max-width: 100%; /* Set a maximum width */
    max-height: 20rem; /* Set a maximum height */
    margin: auto;
    display: block;
    object-fit: contain; /* Ensure the content fits within the container */
  }
  
  header, footer {
    background-color: var(--background-color);
    padding: 1rem;
    font-weight: normal;
    color: #817f7f;
    font-size: 0.6rem;
  }
</style>
