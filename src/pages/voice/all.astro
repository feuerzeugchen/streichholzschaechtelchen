<!-- src/pages/voice/all.astro -->
---
import VoiceLayout from '../../layouts/VoiceLayout.astro';
import type { ImageService } from 'astro';
const posts = (await Astro.glob('../posts/*.md'))
  .map(post => {
    const filename = post.file?.split('/').pop()?.replace('.md', '') ?? '';
    const number = parseInt(filename.replace('Voice', '')) || 0;
    const title = post.frontmatter.title || `Voice${number}`;
    return {
      ...post,
      number,
      title,
      content: post.compiledContent(),
      url: `/voice/page${number}`
    };
  })
  .sort((a, b) => a.number - b.number);
---

<VoiceLayout title="All Voice Entries">
  <div class="posts-container">
    <h1>All Voice Entries</h1>
    
    <div class="posts-grid">
      {posts.map(post => (
        <a href={post.url} class="post-link">
          <article class="post-full">
            <div class="post-content" set:html={post.content} />
          </article>
        </a>
      ))}
    </div>
  </div>
</VoiceLayout>

<style>
  .posts-container {
    padding: 1rem;
    max-width: 100%;
    margin: 0 auto;
  }

  .posts-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit,  minmax(300px, 1fr));
    grid-auto-rows: minmax(200px, auto); /* Adjust the height of the rows */
  }

  .post-link {
    text-decoration: none;
    color: inherit;
  }

  .post-full {

    background: white;
    padding: 0.5rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    aspect-ratio: 5 / 7;
  }
    
  .post-content :global(h2) {
    font-family: 'PT Sans', sans-serif;
    font-size: 10pt;
    line-height: 1.6;
    color: #333;
    margin-top: 1em;
    margin-bottom: 0.75em;
  }

  .post-content {
    font-family: 'PT Sans', sans-serif;
    font-size: 9.5pt;
    line-height: 1.6;
    color: #333;
  }

  .post-full :global(pre),
  .post-full :global(code),
  .post-full :global(.math),
  .post-full :global(blockquote) {
    background-color: #e0f7fa; /* Light blue background */
    font-family: 'PT Sans', sans-serif;
    font-size: 11pt;
    line-height: 1.6;
    padding: 0.5rem;
    border-radius: 4px;
    overflow-wrap: break-word;
    white-space: pre-wrap;
  }

  .post-content :global(pre) {
    overflow-x: auto;
  }

  @media (max-width: 768px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
    
    .post-full {
      padding: 1.5rem;
    }
  }
</style>