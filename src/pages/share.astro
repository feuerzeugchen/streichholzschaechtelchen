---
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import { marked } from 'marked';

const filePath = path.join(process.cwd(), 'src', 'content', 'share.md');
const fileContent = await readFile(filePath, 'utf-8');

// Convert markdown to HTML with clickable links
const htmlContent = marked.parse(fileContent);
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Share Videos</title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    body {
      font-family: 'Arial', sans-serif;
      padding: 2rem;
      background-color: #f0f4f8;
    }
    .day-container {
      max-width: 800px;
      margin: 1rem auto;
      padding: 1rem;
      background-color:#fff;
      border-radius:4px;
      border:1px solid #ddd;
      box-shadow:0 2px 4px rgba(0,0,0,.1);
    }
    .markdown-content {
      line-height:2; /* Double line spacing */
    }
    .markdown-content a {
      color:#007acc;
      text-decoration:none;
    }
    .markdown-content a:hover {
      text-decoration:underline;
    }
    .password-container {
      max-width:400px;margin:auto;padding:1rem;text-align:center;background-color:#fff;border-radius:4px;border:1px solid #ddd;
    }
    .password-container input, .password-container button{
      width:100%;padding:.75rem;margin-top:.5rem;font-size:1rem;border-radius:4px;border:1px solid #ddd;box-sizing:border-box;
    }
    .password-container button{
      background-color:#007acc;color:white;cursor:pointer;border:none;
    }
    #error-message{color:red;display:none;}
  </style>
</head>

<body>

<div id="password-container" class="password-container">
  <h2>Enter Password</h2>
  <input type="password" id="password-input" placeholder="Password"/>
  <button id="password-submit">Submit</button>
  <p id="error-message" style="display:none;color:red;">Incorrect password. Please try again.</p>
</div>

<div id="video-container" style="display:none;">
  <div class="day-container">
    <div class="markdown-content" set:html={marked.parse(fileContent)}></div>
  </div>
</div>

<script>
// Password logic
const correctPassword='adgjl'; // Replace with your actual password

const passwordSubmitButton = document.getElementById('password-submit');
if (passwordSubmitButton) {
  passwordSubmitButton.addEventListener('click', () => {
    const passwordInput = document.getElementById('password-input');
    const input = passwordInput ? (passwordInput as HTMLInputElement).value.trim() : '';

  if(input===correctPassword){
    const passwordContainer = document.getElementById('password-container');
    const videoContainer = document.getElementById('video-container');
    if (passwordContainer && videoContainer) {
      passwordContainer.style.display = 'none';
      videoContainer.style.display = 'block';
    }
  } else {
    const errorMessage = document.getElementById('error-message');
    if (errorMessage) {
      errorMessage.style.display = 'block';
    }
    }
  });
}
</script>

