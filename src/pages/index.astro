---
import StimmeLayout from '../layouts/StimmeLayout.astro';
import fs from 'fs';
import path from 'node:path';

// Lese alle Markdown-Dateien im Verzeichnis
const postsDirectory = path.resolve('./src/content/postsstimme');
const markdownFiles = fs.readdirSync(postsDirectory)
  .filter(file => file.endsWith('.md'))
  .map(file => ({
    filename: file,
    slug: file.replace('.md', ''),
    title: file.replace('.md', '').replace(/-/g, ' ')
  }));
---

<StimmeLayout title="Stimme Entries Index">
  <div class="theme-toggle-container">
    <button id="theme-toggle">Toggle Dark Mode</button>
  </div>
  
  <div class="index-container">
    <h1>Stimme Einträge</h1>
    <ul class="entry-list">
      {markdownFiles.map(file => (
        <li>
          <a href={`/${file.slug}`}>{file.title}</a>
        </li>
      ))}
    </ul>
  </div>
</StimmeLayout>

<script>
  // Dark mode toggle logic
  document.addEventListener('DOMContentLoaded', () => {
    const themeToggle = document.getElementById('theme-toggle');
    const htmlElement = document.documentElement;

    themeToggle.addEventListener('click', () => {
      const currentTheme = htmlElement.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      htmlElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
    });

    // Load saved theme from localStorage
    const savedTheme = localStorage.getItem('theme') || 'light';
    htmlElement.setAttribute('data-theme', savedTheme);
  });
</script>

<style>
  /* Übernehme die Styles aus deinem Original-Code und füge diese hinzu: */
  .index-container {
    max-width: 800px;
    margin: 2rem auto;
    padding: 1rem;
  }
  
  .entry-list {
    list-style-type: none;
    padding: 0;
  }
  
  .entry-list li {
    margin-bottom: 1rem;
    padding: 0.5rem;
    background-color: var(--content-bg-color);
    border-radius: 4px;
  }
  
  .entry-list a {
    color: var(--text-color);
    text-decoration: none;
    font-size: 1.2rem;
    display: block;
    padding: 0.5rem;
  }
  
  .entry-list a:hover {
    text-decoration: underline;
  }
  
  /* Übernimm hier den Rest deiner Styles */
  html {
    font-size: 110%;
    font-family: 'PT Sans';
    background-color: var(--background-color);
    color: var(--text-color);
  } 
  /* Weitere Styles aus deinem Original-Code */
</style>
